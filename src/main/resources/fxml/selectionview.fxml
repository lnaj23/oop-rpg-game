<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../css/common.css" />
        <URL value="@../css/selectionview.css" />
    </stylesheets>

    <top>
        <StackPane fx:id="topPane">
            <Label fx:id="titleLabel" text="Sélection d'équipe" StackPane.alignment="CENTER"/>
        </StackPane>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
            <children>
                <fx:include fx:id="bugemonGrid" source="bugemon_grid.fxml" />
                <fx:include fx:id="teamPanel"   source="team_panel.fxml" />
            </children>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </HBox>
    </center>

    <left>
        <Region prefHeight="520.0" prefWidth="50.0" BorderPane.alignment="CENTER" />
    </left>
    <bottom>
        <Region prefHeight="50.0" prefWidth="900.0" BorderPane.alignment="CENTER" />
    </bottom>

</BorderPane>