<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="892.0" prefWidth="1288.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../../css/common.css" />
        <URL value="@../../css/reward.css" />
    </stylesheets>

    <HBox alignment="CENTER" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="120.0">
        <Label styleClass="reward-title" text="Récompense obtenue !" />
    </HBox>

    <HBox alignment="CENTER" spacing="100.0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="550.0">
        <children>
            <Button fx:id="gainItemBtn" wrapText="true" styleClass="btn-reward, btn-item" text="Continuer" />
            <Button fx:id="learnAttackBtn" wrapText="true" mnemonicParsing="false" styleClass="btn-reward, btn-attack" text="Button" />
            <Button fx:id="gainBonusBtn" wrapText="true" mnemonicParsing="false" styleClass="btn-reward, btn-bonus" text="Button" />
        </children>
    </HBox>

</AnchorPane>