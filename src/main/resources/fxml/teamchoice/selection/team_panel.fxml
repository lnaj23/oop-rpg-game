<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="views.teamchoice.selection.TeamPanelView">

    <VBox fx:id="teamRectangle" alignment="TOP_CENTER" maxHeight="220.0" prefHeight="220.0" prefWidth="350.0" spacing="10.0">
        <children>
            <Label fx:id="teamLabel" text="Ton équipe" />
            <GridPane fx:id="teamGrid" alignment="CENTER" hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
                </rowConstraints>
            </GridPane>
        </children>
    </VBox>

    <Label fx:id="bugemonStatsLabel" prefWidth="350.0" text="Clique sur un Bugémon pour voir ses statistiques" wrapText="true" />

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button fx:id="confirmButton" styleClass="small-button" text="Sauvegarder équipe" />
            <Button fx:id="loadTeamButton" styleClass="small-button" text="Charger équipe" />
            <Button fx:id="playButton" styleClass="small-button" text="Jouer" />
            <Button fx:id="backButton" styleClass="small-button" text="Retour" />
        </children>
    </HBox>

</VBox>
