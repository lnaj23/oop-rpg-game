<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import java.net.URL?>
<AnchorPane prefHeight="346.0" prefWidth="455.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

   <stylesheets>
      <URL value="@../css/addbugemonview.css" />
      <URL value="@../css/common.css" />
   </stylesheets>

   <children>
      <VBox alignment="CENTER"
            spacing="20.0"
            AnchorPane.topAnchor="20.0"
            AnchorPane.bottomAnchor="20.0"
            AnchorPane.leftAnchor="20.0"
            AnchorPane.rightAnchor="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label fx:id="Title" text="AJOUTER UN BUGEMON">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>

            <GridPane hgap="10.0" vgap="10.0" maxWidth="700.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="100.0" prefWidth="132.0" halignment="RIGHT" />
                  <ColumnConstraints hgrow="ALWAYS" fillWidth="true" minWidth="220.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
               </rowConstraints>

               <children>
                  <Label text="Nom :">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Type :" GridPane.rowIndex="1">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="HP :" GridPane.rowIndex="2">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Attaque :" GridPane.rowIndex="3">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Défense :" GridPane.rowIndex="4">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Sprite :" GridPane.rowIndex="5">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Attaque 1 :" GridPane.rowIndex="6">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Attaque 2 :" GridPane.rowIndex="7">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Attaque 3 :" GridPane.rowIndex="8">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <Label text="Starter :" GridPane.rowIndex="9">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>

                  <TextField fx:id="nameField"
                             promptText="Nom du Bugémon"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1" />

                  <TextField fx:id="hpField"
                             promptText="Nbre de vie du Bugémon"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2" />

                  <TextField fx:id="attackField"
                             promptText="Attaque du Bugémon"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="3" />

                  <TextField fx:id="defenseField"
                             promptText="Défense du Bugémon"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="4" />

                  <HBox spacing="10.0"
                        maxWidth="Infinity"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="5">
                     <children>
                        <TextField fx:id="spritePathField"
                                   text="Png de l'ordinateur"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnChooseSprite"
                                mnemonicParsing="false"
                                text="Parcourir" />
                     </children>
                  </HBox>

                  <ChoiceBox fx:id="attack1ChoiceBox"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="6" />

                  <ChoiceBox fx:id="attack2ChoiceBox"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="7" />

                  <ChoiceBox fx:id="attack3ChoiceBox"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="8" />

                  <ChoiceBox fx:id="starterChoiceBox"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="9" />

                  <ChoiceBox fx:id="typeChoiceBox"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1" />
               </children>
            </GridPane>

            <HBox alignment="CENTER" spacing="20.0" maxWidth="700.0">
               <children>
                  <Button fx:id="btnCancel"
                          mnemonicParsing="false"
                          prefHeight="35.0"
                          prefWidth="160.0"
                          text="Annuler" />
                  <Button fx:id="btnAdd"
                          mnemonicParsing="false"
                          prefHeight="36.0"
                          prefWidth="160.0"
                          text="Ajouter" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>