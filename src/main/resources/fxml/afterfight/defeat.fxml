<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="892.0" prefWidth="1288.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../../css/common.css" />
    </stylesheets>

    <VBox alignment="CENTER" spacing="80.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Label fx:id="defeatLabel" alignment="CENTER" contentDisplay="CENTER" text="Skill issue...." textAlignment="CENTER">
            <font>
                <Font size="48.0" />
            </font>
        </Label>

        <Label fx:id="defeatLabel1" alignment="CENTER" contentDisplay="CENTER" text="Vous retournez au début de la Tour NO" textAlignment="CENTER">
            <font>
                <Font size="48.0" />
            </font>
        </Label>

        <HBox alignment="CENTER" spacing="200.0">
            <children>
                <Button fx:id="retryBtn" mnemonicParsing="false" text="Réessayer" />
                <Button fx:id="giveUpBtn" mnemonicParsing="false" text="Retour au menu" />
            </children>
        </HBox>

    </VBox>
</AnchorPane>
