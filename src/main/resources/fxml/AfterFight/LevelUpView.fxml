<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           prefHeight="400.0" prefWidth="600.0"
           style="-fx-background-color: rgb(20, 20, 20);">

   <stylesheets>
      <URL value="@../../css/common.css" />
   </stylesheets>

   <VBox alignment="CENTER" spacing="24">
      <padding>
         <Insets top="30" bottom="20" left="40" right="40"/>
      </padding>

      <!-- Ligne : texte + image du bugémon -->
      <HBox alignment="CENTER" spacing="30">
         <VBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="levelUpLabel"
                   style="-fx-text-fill: #F1C40F; -fx-font-size: 22px; -fx-font-weight: bold;" />
            <Label text="Choisissez une stat à améliorer"
                   style="-fx-text-fill: #F1C40F; -fx-font-size: 18px;" />
         </VBox>
         <ImageView fx:id="bugemonImage"
                    fitHeight="150.0" fitWidth="150.0"
                    pickOnBounds="true" preserveRatio="true" />
      </HBox>

      <!-- Boutons de choix -->
      <HBox alignment="CENTER" spacing="20">
         <Button fx:id="btnOption1" text="Option 1" mnemonicParsing="false"
                 prefWidth="140" prefHeight="50"
                 style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                           -fx-font-size: 18px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand;" />
         <Button fx:id="btnOption2" text="Option 2" mnemonicParsing="false"
                 prefWidth="140" prefHeight="50"
                 style="-fx-background-color: #F1C40F; -fx-text-fill: white;
                           -fx-font-size: 18px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand;" />
         <Button fx:id="btnOption3" text="Option 3" mnemonicParsing="false"
                 prefWidth="140" prefHeight="50"
                 style="-fx-background-color: #3498DB; -fx-text-fill: white;
                           -fx-font-size: 18px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand;" />
      </HBox>

      <!-- Note bas de page -->
      <Label text="Choisir 1 bonus parmi 3. HP régénérés automatiquement."
             style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;" />

   </VBox>

</StackPane>
