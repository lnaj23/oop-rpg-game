<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="892.0" prefWidth="1288.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../css/common.css" />
        <URL value="@../css/fightview.css" />
    </stylesheets>

    <AnchorPane>

        <!-- ===== ADVERSAIRE (haut droite) ===== -->
        <VBox AnchorPane.topAnchor="30" AnchorPane.rightAnchor="250"
              alignment="CENTER" spacing="5">
            <Label fx:id="enemyNameLabel" text="Ennemi (type)" styleClass="bugemon-name-label"/>
            <Label fx:id="enemyHpLabel"   text="HP: 100/100"   styleClass="hp-text-label"/>
            <StackPane>
                <Rectangle fx:id="enemyHpBarBg"   width="200" height="18" styleClass="hp-bar-bg"/>
                <Rectangle fx:id="enemyHpBarFill" width="200" height="18" styleClass="hp-bar-fill"
                           StackPane.alignment="CENTER_LEFT"/>
            </StackPane>
        </VBox>

        <ImageView fx:id="enemySprite" fitHeight="220" preserveRatio="true"
                   AnchorPane.topAnchor="20" AnchorPane.rightAnchor="30"/>

        <!-- ===== JOUEUR (bas gauche) ===== -->
        <ImageView fx:id="playerSprite" fitHeight="260" preserveRatio="true"
                   AnchorPane.bottomAnchor="220" AnchorPane.leftAnchor="30"/>

        <VBox AnchorPane.bottomAnchor="330" AnchorPane.leftAnchor="320"
              alignment="CENTER_LEFT" spacing="5">
            <Label fx:id="playerNameLabel" text="Allié (type)" styleClass="bugemon-name-label"/>
            <Label fx:id="playerHpLabel"   text="HP: 120/120"  styleClass="hp-text-label"/>
            <StackPane>
                <Rectangle fx:id="playerHpBarBg"   width="200" height="18" styleClass="hp-bar-bg"/>
                <Rectangle fx:id="playerHpBarFill" width="200" height="18" styleClass="hp-bar-fill"
                           StackPane.alignment="CENTER_LEFT"/>
            </StackPane>
        </VBox>

        <!-- ===== PANEL D'ACTION (bas centre) ===== -->
        <VBox AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="350"
              AnchorPane.rightAnchor="50" spacing="10">

            <Label fx:id="combatMessageLabel" text="Que va faire votre Bugémon ?"
                   styleClass="combat-message-label" wrapText="true"/>

            <!-- Les 4 boutons principaux -->
            <GridPane fx:id="actionPanel" hgap="15" vgap="15" styleClass="action-panel">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="60"/>
                    <RowConstraints minHeight="60"/>
                </rowConstraints>

                <Button fx:id="btnAttack"  text="Attaquer"        styleClass="btn-attack"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button fx:id="btnItem"    text="Objet"           styleClass="btn-item"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button fx:id="btnSwitch"  text="Changer Bugémon" styleClass="btn-switch"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button fx:id="btnForfeit" text="Abandonner"      styleClass="btn-forfeit"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>

            <!-- Les 3 attaques (caché par défaut) -->
            <GridPane fx:id="attackPanel" hgap="15" vgap="15" styleClass="action-panel"
                      visible="false" managed="false">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="60"/>
                    <RowConstraints minHeight="60"/>
                </rowConstraints>

                <Button fx:id="btnAttack1"        text="Attaque 1" styleClass="btn-attack-move"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button fx:id="btnAttack2"        text="Attaque 2" styleClass="btn-attack-move"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button fx:id="btnAttack3"        text="Attaque 3" styleClass="btn-attack-move"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button fx:id="btnBackFromAttack" text="Retour"    styleClass="btn-forfeit"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>

        </VBox>

    </AnchorPane>

</StackPane>