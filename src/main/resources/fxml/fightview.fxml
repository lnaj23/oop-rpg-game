<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="892.0" prefWidth="1288.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../css/common.css" />
        <URL value="@../css/fightview.css" />
    </stylesheets>

    <AnchorPane>

        <!-- ===== ADVERSAIRES (haut droite, 3 Pokémon) ===== -->
        <GridPane fx:id="enemyTeamPanel" AnchorPane.topAnchor="20" AnchorPane.rightAnchor="30"
                  hgap="20" vgap="20">
            <columnConstraints>
                <ColumnConstraints percentWidth="33"/>
                <ColumnConstraints percentWidth="33"/>
                <ColumnConstraints percentWidth="33"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="100"/>
            </rowConstraints>

            <!-- Ennemi 1 -->
            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label fx:id="enemyNameLabel1" text="Ennemi 1 (type)" styleClass="bugemon-name-label"/>
                <Label fx:id="enemyEffectLabel1" text="Effets : Aucun" styleClass="effect-label"/>
                <Label fx:id="enemyHpLabel1" text="HP: 100/100" styleClass="hp-text-label"/>
                <StackPane>
                    <Rectangle fx:id="enemyHpBarFill1" width="200" height="18" styleClass="hp-bar-fill"
                               StackPane.alignment="CENTER_LEFT"/>
                </StackPane>
                <ImageView fx:id="enemySprite1" fitHeight="120" preserveRatio="true">
                    <image><Image url="@../Assets/png/exceflam.png"/></image>
                </ImageView>
            </VBox>

            <!-- Ennemi 2 -->
            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label fx:id="enemyNameLabel2" text="Ennemi 2 (type)" styleClass="bugemon-name-label"/>
                <Label fx:id="enemyEffectLabel2" text="Effets : Aucun" styleClass="effect-label"/>
                <Label fx:id="enemyHpLabel2" text="HP: 100/100" styleClass="hp-text-label"/>
                <StackPane>
                    <Rectangle fx:id="enemyHpBarFill2" width="200" height="18" styleClass="hp-bar-fill"
                               StackPane.alignment="CENTER_LEFT"/>
                </StackPane>
                <ImageView fx:id="enemySprite2" fitHeight="120" preserveRatio="true">
                    <image><Image url="@../Assets/png/exceflam.png"/></image>
                </ImageView>
            </VBox>

            <!-- Ennemi 3 -->
            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label fx:id="enemyNameLabel3" text="Ennemi 3 (type)" styleClass="bugemon-name-label"/>
                <Label fx:id="enemyEffectLabel3" text="Effets : Aucun" styleClass="effect-label"/>
                <Label fx:id="enemyHpLabel3" text="HP: 100/100" styleClass="hp-text-label"/>
                <StackPane>
                    <Rectangle fx:id="enemyHpBarFill3" width="200" height="18" styleClass="hp-bar-fill"
                               StackPane.alignment="CENTER_LEFT"/>
                </StackPane>
                <ImageView fx:id="enemySprite3" fitHeight="120" preserveRatio="true">
                    <image><Image url="@../Assets/png/exceflam.png"/></image>
                </ImageView>
            </VBox>
        </GridPane>

        <!-- ===== ALLIÉS (bas gauche, 3 Pokémon) ===== -->
        <GridPane fx:id="playerTeamPanel" AnchorPane.bottomAnchor="220" AnchorPane.leftAnchor="30"
                  hgap="20" vgap="20">
            <columnConstraints>
                <ColumnConstraints percentWidth="33"/>
                <ColumnConstraints percentWidth="33"/>
                <ColumnConstraints percentWidth="33"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="100"/>
            </rowConstraints>

            <!-- Allié 1 -->
            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label fx:id="playerNameLabel1" text="Allié 1 (type)" styleClass="bugemon-name-label"/>
                <Label fx:id="playerEffectLabel1" text="Effets : Aucun" styleClass="effect-label"/>
                <Label fx:id="playerHpLabel1" text="HP: 120/120" styleClass="hp-text-label"/>
                <StackPane>
                    <Rectangle fx:id="playerHpBarFill1" width="200" height="18" styleClass="hp-bar-fill"
                               StackPane.alignment="CENTER_LEFT"/>
                </StackPane>
                <ImageView fx:id="playerSprite1" fitHeight="120" preserveRatio="true">
                    <image><Image url="@../Assets/png/florachu.png"/></image>
                </ImageView>
            </VBox>

            <!-- Allié 2 -->
            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label fx:id="playerNameLabel2" text="Allié 2 (type)" styleClass="bugemon-name-label"/>
                <Label fx:id="playerEffectLabel2" text="Effets : Aucun" styleClass="effect-label"/>
                <Label fx:id="playerHpLabel2" text="HP: 120/120" styleClass="hp-text-label"/>
                <StackPane>
                    <Rectangle fx:id="playerHpBarFill2" width="200" height="18" styleClass="hp-bar-fill"
                               StackPane.alignment="CENTER_LEFT"/>
                </StackPane>
                <ImageView fx:id="playerSprite2" fitHeight="120" preserveRatio="true">
                    <image><Image url="@../Assets/png/florachu.png"/></image>
                </ImageView>
            </VBox>

            <!-- Allié 3 -->
            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label fx:id="playerNameLabel3" text="Allié 3 (type)" styleClass="bugemon-name-label"/>
                <Label fx:id="playerEffectLabel3" text="Effets : Aucun" styleClass="effect-label"/>
                <Label fx:id="playerHpLabel3" text="HP: 120/120" styleClass="hp-text-label"/>
                <StackPane>
                    <Rectangle fx:id="playerHpBarFill3" width="200" height="18" styleClass="hp-bar-fill"
                               StackPane.alignment="CENTER_LEFT"/>
                </StackPane>
                <ImageView fx:id="playerSprite3" fitHeight="120" preserveRatio="true">
                    <image><Image url="@../Assets/png/florachu.png"/></image>
                </ImageView>
            </VBox>
        </GridPane>
        <!-- ===== TABLEAU 2x3  ===== -->
        <GridPane fx:id="teamGrid"
                  AnchorPane.topAnchor="350"
                  AnchorPane.rightAnchor="30"
                  hgap="10"
                  vgap="10"/>
        <!-- ===== PANEL D'ACTION (bas centre) ===== -->
        <VBox AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" spacing="10">

            <!-- Message combat -->
            <Label fx:id="combatMessageLabel" text="Que va faire votre Bugémon ?"
                   styleClass="combat-message-label" wrapText="true"/>

            <!-- Les 4 boutons principaux en carré 2x2 -->
            <GridPane fx:id="actionPanel" hgap="15" vgap="15" styleClass="action-panel">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="60"/>
                    <RowConstraints minHeight="60"/>
                </rowConstraints>

                <Button fx:id="btnAttack"  text="Attaquer"        styleClass="btn-attack"
                        GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity"/>
                <Button fx:id="btnItem"    text="Objet"           styleClass="btn-item"
                        GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                <Button fx:id="btnSwitch"  text="Changer Bugémon" styleClass="btn-switch"
                        GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity"/>
                <Button fx:id="btnForfeit" text="Abandonner"      styleClass="btn-forfeit"
                        GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>
            </GridPane>

            <!-- Les 3 attaques (caché par défaut) -->
            <GridPane fx:id="attackPanel" hgap="15" vgap="15" styleClass="action-panel"
                      visible="false" managed="false">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="60"/>
                    <RowConstraints minHeight="60"/>
                </rowConstraints>

                <Button fx:id="btnAttack1"        text="Attaque 1" styleClass="btn-attack-move"
                        GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity"/>
                <Button fx:id="btnAttack2"        text="Attaque 2" styleClass="btn-attack-move"
                        GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                <Button fx:id="btnAttack3"        text="Attaque 3" styleClass="btn-attack-move"
                        GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity"/>
                <Button fx:id="btnBackFromAttack" text="Retour"    styleClass="btn-forfeit"
                        GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>
            </GridPane>

        </VBox>

    </AnchorPane>

</StackPane>