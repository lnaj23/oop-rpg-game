<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane mouseTransparent="true" prefHeight="892.0" prefWidth="1288.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="views.fight.FightActiveBugemon">

    <VBox id="enemy" alignment="TOP_CENTER" mouseTransparent="false" prefWidth="220" spacing="8" AnchorPane.rightAnchor="285.0" AnchorPane.topAnchor="135.0">
        <Label fx:id="enemyNameLabel" styleClass="bugemon-name-label" text="Enemy" />
        <Label fx:id="enemyEffectLabel" prefHeight="77.0" prefWidth="220.0" styleClass="effect-label" text="EnemyEffect" />
        <Label fx:id="enemyHpLabel" styleClass="hp-text-label" text="EnemyHP" />
        <ProgressBar fx:id="enemyHpBarFill" prefWidth="210.0" progress="1.0" />
        <ImageView fx:id="enemySprite" fitHeight="180" preserveRatio="true" />
    </VBox>

    <VBox id="player" alignment="TOP_CENTER" mouseTransparent="false" prefWidth="220" spacing="8" AnchorPane.leftAnchor="373.0" AnchorPane.topAnchor="135.0">
        <Label fx:id="playerNameLabel" styleClass="bugemon-name-label" text="player" />
        <Label fx:id="playerEffectLabel" prefHeight="77.0" prefWidth="220.0" styleClass="effect-label" text="PlayerEffect" />
        <Label fx:id="playerHpLabel" styleClass="hp-text-label" text="PlayerHP" />
        <ProgressBar fx:id="playerHpBarFill" prefWidth="210.0" progress="1.0" />
        <ImageView fx:id="playerSprite" fitHeight="180" preserveRatio="true" />
    </VBox>

</AnchorPane>
