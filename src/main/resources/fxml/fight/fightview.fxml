<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="892.0" prefWidth="1288.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../../css/common.css" />
        <URL value="@../../css/fightview.css" />
    </stylesheets>

    <AnchorPane prefHeight="892.0" prefWidth="1288.0">

        <VBox id="enemy" alignment="CENTER" layoutX="791.0" layoutY="199.0" prefWidth="220" spacing="8" AnchorPane.rightAnchor="277.0" AnchorPane.topAnchor="199.0">
            <Label fx:id="enemyNameLabel" styleClass="bugemon-name-label" text="Enemy" />
            <Label fx:id="enemyEffectLabel" styleClass="effect-label" text="EnemyEffect" />
            <Label fx:id="enemyHpLabel" styleClass="hp-text-label" text="EnemyHP" />
            <ProgressBar fx:id="enemyHpBarFill" prefWidth="200.0" progress="1.0" />
            <ImageView fx:id="enemySprite" fitHeight="180" preserveRatio="true" />
         <VBox id="team" alignment="CENTER" prefWidth="200" spacing="10">
            <children>
               <Label style="-fx-font-size:18; -fx-font-weight:bold;" text="Équipe de l'adversaire" />
               <GridPane fx:id="enemyGrid" hgap="10" vgap="10">
                  <columnConstraints>
                     <ColumnConstraints percentWidth="33" />
                     <ColumnConstraints percentWidth="33" />
                     <ColumnConstraints percentWidth="33" />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints percentHeight="50" />
                     <RowConstraints percentHeight="50" />
                  </rowConstraints>
               </GridPane>
            </children>
         </VBox>
        </VBox>

        <VBox id="player" alignment="CENTER" layoutX="375.0" layoutY="207.0" prefWidth="220" spacing="8" AnchorPane.leftAnchor="375.0" AnchorPane.topAnchor="207.0">
            <Label fx:id="playerNameLabel" styleClass="bugemon-name-label" text="player" />
            <Label fx:id="playerEffectLabel" styleClass="effect-label" text="PlayerEffect" />
            <Label fx:id="playerHpLabel" styleClass="hp-text-label" text="PlayerHP" />
            <ProgressBar fx:id="playerHpBarFill" prefWidth="200.0" progress="1.0" />
            <ImageView fx:id="playerSprite" fitHeight="180" preserveRatio="true" />
   
           <VBox id="team" alignment="CENTER" prefWidth="200" spacing="10">
               <Label style="-fx-font-size:18; -fx-font-weight:bold;" text="Équipe du joueur" />
               <GridPane fx:id="teamGrid" hgap="10" vgap="10">
                   <columnConstraints>
                       <ColumnConstraints percentWidth="33" />
                       <ColumnConstraints percentWidth="33" />
                       <ColumnConstraints percentWidth="33" />
                   </columnConstraints>
                   <rowConstraints>
                       <RowConstraints percentHeight="50" />
                       <RowConstraints percentHeight="50" />
                   </rowConstraints>
               </GridPane>
           </VBox>
        </VBox>

        <VBox id="choice" spacing="10" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

            <Label fx:id="combatMessageLabel" styleClass="combat-message-label" text="Message Combat" wrapText="true" />

            <GridPane fx:id="actionPanel" hgap="15" styleClass="action-panel" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="60" />
                    <RowConstraints minHeight="60" />
                </rowConstraints>
                <Button fx:id="btnAttack" maxWidth="Infinity" styleClass="btn-attack" text="Attaquer" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button fx:id="btnItem" maxWidth="Infinity" styleClass="btn-item" text="Objet" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button fx:id="btnSwitch" maxWidth="Infinity" styleClass="btn-switch" text="Changer Bugémon" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button fx:id="btnForfeit" maxWidth="Infinity" styleClass="btn-forfeit" text="Abandonner" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>

            <GridPane fx:id="attackPanel" hgap="15" managed="false" styleClass="action-panel" vgap="15" visible="false">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="60" />
                    <RowConstraints minHeight="60" />
                </rowConstraints>
                <Button fx:id="btnAttack1" maxWidth="Infinity" styleClass="btn-attack-move" text="Attaque 1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button fx:id="btnAttack2" maxWidth="Infinity" styleClass="btn-attack-move" text="Attaque 2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button fx:id="btnAttack3" maxWidth="Infinity" styleClass="btn-attack-move" text="Attaque 3" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button fx:id="btnBackFromAttack" maxWidth="Infinity" styleClass="btn-forfeit" text="Retour" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>

        </VBox>

    </AnchorPane>

</StackPane>
